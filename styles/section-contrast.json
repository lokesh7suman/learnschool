{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Inverted Contrast Section",
	"slug": "section-contrast",
	"blockTypes": [
		"core/group",
		"core/cover"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|contrast",
			"text": "var:preset|color|base"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|secondary"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|base"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary-light",
					"text": "var:preset|color|contrast"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent",
						"text": "var:preset|color|contrast"
					}
				}
			}
		},
		"blocks": {
			"core/heading": {
				"color": {
					"text": "var:preset|color|base"
				}
			},
			"core/paragraph": {
				"color": {
					"text": "var:preset|color|base-subtle"
				}
			}
		}
	}
}
