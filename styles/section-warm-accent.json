{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Warm Accent Section",
	"slug": "section-warm-accent",
	"blockTypes": [
		"core/group",
		"core/cover"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|warning",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|primary-dark"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|base"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary-dark",
						"text": "var:preset|color|base"
					}
				}
			}
		},
		"blocks": {
			"core/heading": {
				"color": {
					"text": "var:preset|color|contrast"
				}
			},
			"core/paragraph": {
				"color": {
					"text": "var:preset|color|contrast-subtle"
				}
			}
		}
	}
}
