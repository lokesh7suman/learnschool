{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Sunshine Playful",
	"slug": "sunshine-playful",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base",            "color": "#fffdf5", "name": "Base / Warm Cream" },
				{ "slug": "base-subtle",     "color": "#fef8e7", "name": "Base Subtle / Honey Tint" },
				{ "slug": "contrast",        "color": "#1f1d18", "name": "Contrast / Dark Espresso" },
				{ "slug": "contrast-subtle", "color": "#615c50", "name": "Contrast Subtle / Muted Toast" },
				{ "slug": "primary",         "color": "#d97706", "name": "Primary / Warm Amber" },
				{ "slug": "primary-dark",    "color": "#b45309", "name": "Primary Dark / Deep Bronze" },
				{ "slug": "primary-light",   "color": "#fef3c7", "name": "Primary Light / Pale Amber" },
				{ "slug": "secondary",       "color": "#ffbe17", "name": "Secondary / Sunshine Gold" },
				{ "slug": "secondary-dark",  "color": "#d97706", "name": "Secondary Dark / Warm Amber" },
				{ "slug": "accent",          "color": "#ffd25d", "name": "Accent / Pastel Yellow" },
				{ "slug": "surface",         "color": "#ffffff", "name": "Surface / White" },
				{ "slug": "surface-slate",   "color": "#fbfaf4", "name": "Surface Warm" },
				{ "slug": "border",          "color": "#fae5af", "name": "Border / Golden Tint" },
				{ "slug": "success",         "color": "#16a34a", "name": "Success" },
				{ "slug": "error",           "color": "#dc2626", "name": "Error" },
				{ "slug": "warning",         "color": "#fef3c7", "name": "Warning Background" },
				{ "slug": "warning-text",    "color": "#92400e", "name": "Warning Text" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|primary" },
				":hover": { "color": { "text": "var:preset|color|primary-dark" } }
			},
			"heading": {
				"color": { "text": "var:preset|color|contrast" }
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|surface"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary-dark",
						"text": "var:preset|color|surface"
					}
				}
			}
		}
	}
}
