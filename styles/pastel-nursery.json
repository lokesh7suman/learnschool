{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Pastel Nursery",
	"slug": "pastel-nursery",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base",            "color": "#faf9fe", "name": "Base / Pastel Whisper" },
				{ "slug": "base-subtle",     "color": "#f1effd", "name": "Base Subtle / Soft Lavender" },
				{ "slug": "contrast",        "color": "#1c192b", "name": "Contrast / Midnight Ink" },
				{ "slug": "contrast-subtle", "color": "#5e577a", "name": "Contrast Subtle / Muted Iris" },
				{ "slug": "primary",         "color": "#8b6bf7", "name": "Primary / Pastel Violet" },
				{ "slug": "primary-dark",    "color": "#6e4ce0", "name": "Primary Dark" },
				{ "slug": "primary-light",   "color": "#dec8fe", "name": "Primary Light / Lilac Mist" },
				{ "slug": "secondary",       "color": "#4ecdc4", "name": "Secondary / Pastel Mint" },
				{ "slug": "secondary-dark",  "color": "#2ca89f", "name": "Secondary Dark" },
				{ "slug": "secondary-gold",  "color": "#2ca89f", "name": "Secondary Gold" },
				{ "slug": "accent",          "color": "#ffd25d", "name": "Accent / Pastel Yellow" },
				{ "slug": "surface",         "color": "#ffffff", "name": "Surface / White" },
				{ "slug": "surface-slate",   "color": "#f7f6fc", "name": "Surface Tint" },
				{ "slug": "midnight",        "color": "#1c192b", "name": "Midnight / Deep Ink" },
				{ "slug": "border",          "color": "#e2def2", "name": "Border / Iris Tint" },
				{ "slug": "border-subtle",   "color": "#f4f2fc", "name": "Border Subtle / Extra Light" },
				{ "slug": "info",            "color": "#0284c7", "name": "Info Blue" },
				{ "slug": "info-light",      "color": "#e0f2fe", "name": "Info Light / Sky Tint" },
				{ "slug": "success",         "color": "#15803d", "name": "Success Green" },
				{ "slug": "error",           "color": "#dc2626", "name": "Alert Red" },
				{ "slug": "warning",         "color": "#fef3c7", "name": "Warning Background" },
				{ "slug": "warning-text",    "color": "#92400e", "name": "Warning Text" },
				{ "slug": "success-light",   "color": "#dcfce7", "name": "Success Light / Soft Mint" },
				{ "slug": "rose-light",      "color": "#fce7f3", "name": "Rose Light / Soft Pink" },
				{ "slug": "rose",            "color": "#be185d", "name": "Rose / Studio Pink" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|primary" },
				":hover": { "color": { "text": "var:preset|color|primary-dark" } }
			},
			"heading": {
				"color": { "text": "var:preset|color|contrast" }
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|surface"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary-dark",
						"text": "var:preset|color|surface"
					}
				}
			}
		}
	}
}
