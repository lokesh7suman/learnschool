#: patterns/faq-accordion-doodle.php
msgctxt "Pattern title"
msgid "FAQ Accordion"
msgstr ""

#: patterns/faq-accordion-doodle.php
msgctxt "Pattern description"
msgid "Two-column frequently asked questions section with expandable accordion panels."
