{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (No Title)",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-full-width",
			"title": "Full Width",
			"postTypes": [ "page", "post" ]
		},
		{
			"name": "page-with-sidebar",
			"title": "Page with Sidebar",
			"postTypes": [ "page", "post" ]
		},
		{
			"name": "landing-page",
			"title": "Landing Page",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "sidebar",
			"title": "Sidebar",
			"area": "sidebar"
		},
		{
			"name": "post-meta",
			"title": "Post Meta",
			"area": "uncategorized"
		},
		{
			"name": "comments",
			"title": "Comments",
			"area": "uncategorized"
		}
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"layout": {
			"contentSize": "780px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base / White"
				},
				{
					"slug": "base-subtle",
					"color": "#f8f9fa",
					"name": "Base Subtle / Off-White"
				},
				{
					"slug": "contrast",
					"color": "#121212",
					"name": "Contrast / Charcoal"
				},
				{
					"slug": "contrast-subtle",
					"color": "#4b5563",
					"name": "Contrast Subtle / Muted Gray"
				},
				{
					"slug": "primary",
					"color": "#704fe6",
					"name": "Primary / WonderKids Purple"
				},
				{
					"slug": "primary-dark",
					"color": "#5837c7",
					"name": "Primary Dark / Deep Purple"
				},
				{
					"slug": "primary-light",
					"color": "#dec8fe",
					"name": "Primary Light / Soft Lilac"
				},
				{
					"slug": "secondary",
					"color": "#ffbe17",
					"name": "Secondary / Sunny Gold"
				},
				{
					"slug": "secondary-dark",
					"color": "#b45309",
					"name": "Secondary Dark / Warm Amber"
				},
				{
					"slug": "secondary-gold",
					"color": "#ffb802",
					"name": "Secondary Gold / Display Gold"
				},
				{
					"slug": "accent",
					"color": "#ffd25d",
					"name": "Accent / Pastel Yellow"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Surface / White"
				},
				{
					"slug": "surface-slate",
					"color": "#f8fafc",
					"name": "Surface Slate"
				},
				{
					"slug": "midnight",
					"color": "#1a162b",
					"name": "Midnight / Deep Navy"
				},
				{
					"slug": "border",
					"color": "#e2e8f0",
					"name": "Border / Soft Gray"
				},
				{
					"slug": "border-subtle",
					"color": "#f1f5f9",
					"name": "Border Subtle / Extra Light"
				},
				{
					"slug": "info",
					"color": "#0284c7",
					"name": "Info Blue"
				},
				{
					"slug": "info-light",
					"color": "#e0f2fe",
					"name": "Info Light / Sky Tint"
				},
				{
					"slug": "success",
					"color": "#15803d",
					"name": "Success Green"
				},
				{
					"slug": "error",
					"color": "#dc2626",
					"name": "Alert Red"
				},
				{
					"slug": "warning",
					"color": "#fef3c7",
					"name": "Warning Background"
				},
				{
					"slug": "warning-text",
					"color": "#92400e",
					"name": "Warning Text"
				},
				{
					"slug": "success-light",
					"color": "#dcfce7",
					"name": "Success Light / Soft Mint"
				},
				{
					"slug": "rose-light",
					"color": "#fce7f3",
					"name": "Rose Light / Soft Pink"
				},
				{
					"slug": "rose",
					"color": "#be185d",
					"name": "Rose / Studio Pink"
				}
			],
			"gradients": [
				{
					"slug": "purple-indigo",
					"gradient": "linear-gradient(135deg, #704fe6 0%, #4338ca 100%)",
					"name": "Purple to Indigo"
				},
				{
					"slug": "warm-amber",
					"gradient": "linear-gradient(135deg, #ffbe17 0%, #d97706 100%)",
					"name": "Warm Amber"
				},
				{
					"slug": "lilac-mist",
					"gradient": "linear-gradient(135deg, #f8fafc 0%, #dec8fe 100%)",
					"name": "Lilac Mist"
				},
				{
					"slug": "soft-gold",
					"gradient": "linear-gradient(135deg, #fffdf9 0%, #ffd25d 100%)",
					"name": "Soft Gold Fade"
				}
			]
		},
		"typography": {
			"fluid": {
				"minFontSize": "0.875rem"
			},
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Quicksand\", \"Plus Jakarta Sans\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
					"name": "Quicksand",
					"slug": "quicksand",
					"fontFace": [
						{
							"fontFamily": "Quicksand",
							"fontWeight": "300 700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/quicksand/quicksand-variable.woff2"
							]
						}
					]
				},
				{
					"fontFamily": "\"Courgette\", \"Brush Script MT\", cursive",
					"name": "Courgette",
					"slug": "courgette",
					"fontFace": [
						{
							"fontFamily": "Courgette",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/courgette/courgette-regular.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"size": "0.75rem",
					"fluid": {
						"min": "0.75rem",
						"max": "0.75rem"
					},
					"name": "Extra Small (12px)"
				},
				{
					"slug": "small",
					"size": "0.875rem",
					"fluid": {
						"min": "0.875rem",
						"max": "0.875rem"
					},
					"name": "Small (14px)"
				},
				{
					"slug": "base",
					"size": "1rem",
					"fluid": {
						"min": "0.9375rem",
						"max": "1rem"
					},
					"name": "Base (16px)"
				},
				{
					"slug": "medium",
					"size": "1.125rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					},
					"name": "Medium / Body (18px)"
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					},
					"name": "Large / Card Title (24px)"
				},
				{
					"slug": "medium-large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.75rem"
					},
					"name": "Medium Large (28px)"
				},
				{
					"slug": "x-large",
					"size": "2.5rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.5rem"
					},
					"name": "Extra Large / Feature Title (40px)"
				},
				{
					"slug": "xx-large",
					"size": "3.75rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.75rem"
					},
					"name": "2X Large / Section Title (60px)"
				},
				{
					"slug": "display",
					"size": "4.75rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.75rem"
					},
					"name": "Display / Hero Banner (76px)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingSizes": [
				{
					"slug": "step-1",
					"size": "0.5rem",
					"name": "Step 1 (8px)"
				},
				{
					"slug": "step-2",
					"size": "0.75rem",
					"name": "Step 2 (12px)"
				},
				{
					"slug": "step-3",
					"size": "clamp(0.875rem, 0.4vw + 0.75rem, 1.125rem)",
					"name": "Step 3 (16px)"
				},
				{
					"slug": "step-4",
					"size": "clamp(1.25rem, 1vw + 1rem, 1.75rem)",
					"name": "Step 4 (24px)"
				},
				{
					"slug": "step-5",
					"size": "clamp(1.5rem, 2vw + 1rem, 2.5rem)",
					"name": "Step 5 (32px)"
				},
				{
					"slug": "step-6",
					"size": "clamp(2rem, 3.5vw + 1.125rem, 3.75rem)",
					"name": "Step 6 (48px)"
				},
				{
					"slug": "step-7",
					"size": "clamp(2.5rem, 5vw + 1.25rem, 5.5rem)",
					"name": "Step 7 (72px)"
				},
				{
					"slug": "step-8",
					"size": "clamp(3.5rem, 7vw + 1.75rem, 7.5rem)",
					"name": "Step 8 (96px)"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft Pill Shadow",
					"slug": "card",
					"shadow": "0 10px 30px -5px rgba(112, 79, 230, 0.08), 0 4px 6px -2px rgba(112, 79, 230, 0.04)"
				},
				{
					"name": "Elevated Shadow",
					"slug": "elevated",
					"shadow": "0 20px 40px -10px rgba(18, 18, 18, 0.1), 0 8px 10px -4px rgba(18, 18, 18, 0.04)"
				},
				{
					"name": "Gold Glow Shadow",
					"slug": "gold",
					"shadow": "0 12px 28px -4px rgba(255, 190, 23, 0.2)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|quicksand",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|step-4",
			"padding": {
				"left": "var:preset|spacing|step-4",
				"right": "var:preset|spacing|step-4"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary-dark"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|primary",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|quicksand",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"fontWeight": "700",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var:preset|font-family|quicksand",
					"fontSize": "var:preset|font-size|xx-large",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var:preset|font-family|quicksand",
					"fontSize": "var:preset|font-size|medium-large",
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var:preset|font-family|quicksand",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700",
					"lineHeight": "1.3"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var:preset|font-family|quicksand",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "700",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var:preset|font-family|quicksand",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "700",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"border": {
					"radius": "9999px"
				},
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|base"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|quicksand",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "700"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|step-2",
						"bottom": "var:preset|spacing|step-2",
						"left": "var:preset|spacing|step-4",
						"right": "var:preset|spacing|step-4"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary-dark",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|primary-dark",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|contrast-subtle"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var:preset|spacing|step-3"
					}
				}
			},
			"core/query-pagination": {
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|step-6",
						"bottom": "var:preset|spacing|step-5"
					}
				}
			},
			"core/template-part": {
				"spacing": {
					"margin": {
						"top": "0px",
						"bottom": "0px"
					}
				}
			},
			"core/group": {
				"variations": {
					"learnschool-card": {
						"border": {
							"radius": "24px"
						},
						"color": {
							"background": "var:preset|color|surface"
						},
						"shadow": "var:preset|shadow|card"
					}
				}
			},
			"core/button": {
				"border": {
					"radius": "9999px"
				},
				"typography": {
					"fontSize": "var:preset|font-size|base",
					"fontWeight": "700"
				}
			},
			"core/details": {
				"border": {
					"color": "var:preset|color|border",
					"radius": "20px",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|surface"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|step-4",
						"bottom": "var:preset|spacing|step-4",
						"left": "var:preset|spacing|step-4",
						"right": "var:preset|spacing|step-4"
					}
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|primary",
						"style": "solid",
						"width": "4px"
					}
				},
				"color": {
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|step-4"
					}
				},
				"typography": {
					"fontStyle": "italic"
				}
			},
			"core/table": {
				"border": {
					"color": "var:preset|color|border",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|surface"
				}
			},
			"core/navigation": {
				"typography": {
					"fontWeight": "600",
					"fontSize": "var:preset|font-size|base"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|quicksand",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"core/code": {
				"border": {
					"color": "var:preset|color|border",
					"radius": "16px",
					"style": "solid",
					"width": "1.5px"
				},
				"color": {
					"background": "var:preset|color|base-subtle",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|step-3",
						"bottom": "var:preset|spacing|step-3",
						"left": "var:preset|spacing|step-4",
						"right": "var:preset|spacing|step-4"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.6"
				}
			},
			"core/verse": {
				"border": {
					"color": "var:preset|color|primary-light",
					"radius": "0 20px 20px 0",
					"style": "solid",
					"width": "1.5px",
					"left": {
						"color": "var:preset|color|primary",
						"style": "solid",
						"width": "4px"
					}
				},
				"color": {
					"background": "var:preset|color|base-subtle",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|step-4",
						"bottom": "var:preset|spacing|step-4",
						"left": "var:preset|spacing|step-5",
						"right": "var:preset|spacing|step-5"
					},
					"margin": {
						"top": "var:preset|spacing|step-5",
						"bottom": "var:preset|spacing|step-5"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|quicksand",
					"fontStyle": "italic",
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.8"
				}
			},
			"core/audio": {
				"border": {
					"color": "var:preset|color|primary-light",
					"radius": "24px",
					"style": "solid",
					"width": "1.5px"
				},
				"color": {
					"background": "var:preset|color|base-subtle"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|step-4",
						"bottom": "var:preset|spacing|step-4",
						"left": "var:preset|spacing|step-4",
						"right": "var:preset|spacing|step-4"
					},
					"margin": {
						"top": "var:preset|spacing|step-5",
						"bottom": "var:preset|spacing|step-5"
					}
				}
			},
			"core/social-links": {
				"spacing": {
					"blockGap": "var:preset|spacing|step-2"
				}
			}
		}
	}
}
