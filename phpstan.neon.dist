includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - functions.php
        - patterns
        - inc
    excludePaths:
        analyseAndScan:
            - vendor/ (?)
            - node_modules/ (?)
            - assets/ (?)
            - build/ (?)
    treatPhpDocTypesAsCertain: false
