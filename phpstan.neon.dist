includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 8
    paths:
        - functions.php
        - patterns
        - inc
    excludePaths:
        analyseAndScan:
            - vendor/*
            - node_modules/*
            - assets/*
            - build/*
    treatPhpDocTypesAsCertain: false
