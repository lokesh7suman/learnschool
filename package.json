{
	"name": "learnschool",
	"version": "1.0.5",
	"description": "Full-site editing block theme built for educational institutions, academies, and schools.",
	"author": "codeclove",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"block-theme",
		"full-site-editing",
		"education"
	],
	"homepage": "https://codeclove.com/learnschool",
	"repository": {
		"type": "git",
		"url": "https://github.com/codeclove/learnschool.git"
	},
	"bugs": {
		"url": "https://github.com/codeclove/learnschool/issues"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=10.0.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@wordpress/scripts": "^30.0.0",
		"adm-zip": "^0.6.1",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"fast-glob": "^3.3.2",
		"husky": "^9.0.0",
		"lint-staged": "^15.0.0"
	},
	"overrides": {
		"typescript": "5.7.3"
	},
	"scripts": {
		"build:zip": "node bin/build-zip.js",
		"bundle": "npm run check && node bin/build-zip.js",
		"check": "npm run lint:css && npm run lint:js && npm run lint:json && npm run lint:php && npm run lint:phpstan && npm run lint:theme",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style '**/*.css' --ignore-path .gitignore",
		"lint:js": "wp-scripts lint-js 'assets/js/**/*.js'",
		"lint:json": "wp-scripts lint-pkg-json",
		"lint:php": "composer run lint",
		"lint:php:fix": "composer run lint:fix",
		"lint:phpstan": "composer run phpstan",
		"lint:theme": "node theme-utils.mjs validate-theme",
		"lint:patterns:fix": "node theme-utils.mjs escape-patterns --text-domain=learnschool",
		"makepot": "wp i18n make-pot . languages/learnschool.pot",
		"prepare": "husky",
		"test": "npm run check",
		"test:e2e": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 wp-scripts test-playwright",
		"test:e2e:ui": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 wp-scripts test-playwright --ui"
	}
}
