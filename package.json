{
	"name": "learnschool",
	"version": "1.0.5",
	"description": "Full-site editing block theme built for educational institutions, academies, and schools.",
	"author": "codeclove",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"block-theme",
		"full-site-editing",
		"education"
	],
	"homepage": "https://codeclove.com/learnschool",
	"repository": {
		"type": "git",
		"url": "https://github.com/codeclove/learnschool.git"
	},
	"bugs": {
		"url": "https://github.com/codeclove/learnschool/issues"
	},
	"devDependencies": {
		"@wordpress/block-serialization-default-parser": "^6.1.0",
		"@wordpress/env": "^10.0.0",
		"@wordpress/scripts": "^30.0.0",
		"@wp-playground/cli": "^3.1.65",
		"adm-zip": "^0.6.1",
		"ajv": "^8.20.0",
		"ajv-cli": "^5.0.0",
		"fast-glob": "^3.3.3"
	},
	"scripts": {
		"build:zip": "node bin/build-zip.js",
		"bundle": "npm run check && node bin/build-zip.js",
		"check": "npm run lint:schema && npm run lint:blocks && npm run lint:css && npm run lint:json && composer run lint && composer run analyze",
		"clean:db": "node bin/fix-patterns.js --clean-db --no-browser",
		"env": "wp-env",
		"fix:patterns": "node bin/fix-patterns.js --clean-db",
		"format": "wp-scripts format",
		"lint:blocks": "node bin/lint-blocks.js",
		"lint:css": "wp-scripts lint-style 'style.css'",
		"lint:json": "wp-scripts lint-pkg-json",
		"lint:schema": "node bin/validate-theme.js",
		"test": "npm run check",
		"test:patterns": "php .tests/e2e-patterns-test.php --strict && node .tests/gutenberg-e2e-validate.js",
		"test:patterns:existing": "php .tests/e2e-patterns-test.php --only-existing",
		"test:setup": "node bin/setup-test-data.js",
		"verify:playground": "wp-playground server --auto-mount --blueprint=blueprint.json"
	}
}
